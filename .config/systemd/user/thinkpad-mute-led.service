[Unit]
Description=Sync ThinkPad mute LED with the active audio output
After=pipewire-pulse.service
Wants=pipewire-pulse.service
ConditionPathExists=/sys/class/leds/platform::mute/brightness

[Service]
ExecStart=/usr/bin/python3 %h/.config/audio/mute_led.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
