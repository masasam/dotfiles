{
  "custom/hyprwhspr": {
    "format": "󰍬",
    "exec": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh status",
    "interval": 1,
    "return-type": "json",
    "exec-on-event": true,
    "on-click": "/usr/bin/python3 ~/.config/hyprwhspr/ondemand.py toggle",
    "on-click-right": "/usr/bin/python3 ~/.config/hyprwhspr/ondemand.py restart",
    "tooltip": true
  }
}
