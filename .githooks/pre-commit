#!/usr/bin/env python3
"""Run fast secret checks before creating a commit."""

from __future__ import annotations

import subprocess
from pathlib import Path


def main() -> int:
    root = Path(
        subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True
        ).strip()
    )
    print("pre-commit: checking staged secrets")
    return subprocess.run(
        ["make", "check-secrets-staged"], cwd=root, check=False
    ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
